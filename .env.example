# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=your-neon-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-secret-access-key
AWS_ENDPOINT_URL_S3=https://your-branch-id.storage.us-east-2.neon.tech
AWS_REGION=us-east-2
ASSETS_BUCKET=assets

# Application Settings
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=min-32-chars-random-secret-key-for-jwt-signing
ADMISSION_LAST_DATE=2026-12-25
